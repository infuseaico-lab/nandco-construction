# Cache rules for Netlify / Cloudflare Pages (ignored by other hosts).
# Photos and fonts never change under the same name; CSS and JS are re-checked daily.
/assets/img/*
  Cache-Control: public, max-age=31536000
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/brand/*
  Cache-Control: public, max-age=31536000
/assets/css/*
  Cache-Control: public, max-age=86400
/assets/js/*
  Cache-Control: public, max-age=86400
